# =====================================================================
# CYBER THREAT INTELLIGENCE ANALYSIS PLATFORM - CONFIGURATION
# =====================================================================

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
ENVIRONMENT=production
DEBUG=False

# Database URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./threat_intel.db
# For PostgreSQL: postgresql://user:password@localhost:5432/threat_intel

# Threat Intelligence Provider API Keys (Optional - Never Hardcoded)
# If left blank, the platform remains 100% operational using local intelligence,
# signature databases, live DNS infrastructure, and heuristic/ML engines.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
ALIENVAULT_OTX_API_KEY=

# Rate Limits (Requests per Minute)
VIRUSTOTAL_RPM=4
ABUSEIPDB_RPM=20
URLHAUS_RPM=30
ALIENVAULT_RPM=30

# In-Memory TTL Cache (Seconds)
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600

# Risk Scoring Configurable Weights (Must sum to ~1.0)
WEIGHT_REPUTATION=0.35
WEIGHT_HEURISTICS=0.25
WEIGHT_COMMUNITY=0.25
WEIGHT_AI_ML=0.15

# Security & SSRF Protection
ALLOW_PRIVATE_IPS=False
REQUEST_TIMEOUT_SECONDS=5
MAX_REDIRECTS=3
MAX_UPLOAD_SIZE_MB=50
